{
  "name": "@docubook/monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@docubook/flame...",
    "lint": "oxlint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
    "publish-packages": "pnpm build && changeset publish",
    "prepare": "husky",
    "commit": "czg",
    "test": "turbo test",
    "test:release-plan": "node scripts/check-release-plan.mjs",
    "test:browser-smoke": "node scripts/flame-browser-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "czg": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "oxlint": "^1.80.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
