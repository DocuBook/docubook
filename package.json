{
  "name": "@docubook/monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "lint": "oxlint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
