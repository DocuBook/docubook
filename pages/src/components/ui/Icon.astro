---
// Lucide icon by kebab-case name, so content files can stay plain data.
// x/y place it inside a parent <svg> (the feature tiles print their icon this way).
import { ArrowRight, ArrowUpRight, Blocks, Check, CloudUpload, Copy, CornerDownLeft, ExternalLink, FileCode2, FilePenLine, FileText, Flame, Folder, FolderOpen, FolderTree, GitFork, Globe, Hammer, Layers, LockKeyhole, Palette, Plug, Route, Scale, Search, Server, ShieldCheck, Sparkles, Star, Terminal, Upload, Zap } from "@lucide/astro";
const icons = { "arrow-right": ArrowRight, "arrow-up-right": ArrowUpRight, blocks: Blocks, check: Check, "cloud-upload": CloudUpload, copy: Copy, "corner-down-left": CornerDownLeft, "external-link": ExternalLink, "file-code-2": FileCode2, "file-pen-line": FilePenLine, "file-text": FileText, flame: Flame, folder: Folder, "folder-open": FolderOpen, "folder-tree": FolderTree, "git-fork": GitFork, globe: Globe, hammer: Hammer, layers: Layers, "lock-keyhole": LockKeyhole, palette: Palette, plug: Plug, route: Route, scale: Scale, search: Search, server: Server, "shield-check": ShieldCheck, sparkles: Sparkles, star: Star, terminal: Terminal, upload: Upload, zap: Zap };
export type IconName = keyof typeof icons;
interface Props { name: IconName | string; size?: number; class?: string; strokeWidth?: number; x?: number; y?: number }
const { name, size = 16, class: className = "", strokeWidth = 1.75, x, y } = Astro.props;
const Svg = icons[name as IconName];
if (!Svg) throw new Error(`Unknown icon "${name}"`);
---

<Svg size={size} stroke-width={strokeWidth} class={className} x={x} y={y} aria-hidden="true" />
