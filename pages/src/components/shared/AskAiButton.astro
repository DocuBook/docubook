---
// Navbar Ask AI button. DocSearch's side panel (script and styles) loads on the first hover, focus or
// click of any [data-ask-ai-trigger], so the page itself ships no DocSearch or framework code.
---

<button type="button" class="inline-flex h-[50px] items-center gap-2.5 rounded bg-ink px-[22px] text-sm font-semibold text-white" data-ask-ai-trigger>
  Ask AI
  <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" /><path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" /></svg>
</button>
<div id="ask-ai-mount" hidden></div>

<script>
  // ?url keeps DocSearch's styles out of the page's inlined CSS; they are attached when the panel loads.
  import styleUrl from "@docsearch/css/dist/style.css?url";
  import sidepanelUrl from "@docsearch/css/dist/sidepanel.css?url";

  // __ASK_AI__ is injected by astro.config.mjs from packages/flame/docu.json: same Algolia agent as the docs.
  type Panel = { readonly isReady: boolean; open(): void };
  let panel: Promise<Panel> | undefined;
  const stylesheet = (href: string) =>
    new Promise<void>((resolve) => {
      const link = Object.assign(document.createElement("link"), { rel: "stylesheet", href });
      link.onload = link.onerror = () => resolve();
      document.head.append(link);
    });
  // Resolve only once DocSearch reports ready: open() before that is a no-op.
  const load = () =>
    (panel ??= Promise.all([
      import("@docsearch/sidepanel-js"),
      stylesheet(styleUrl),
      stylesheet(sidepanelUrl),
    ]).then(
      ([{ default: sidepanel }]) =>
        new Promise<Panel>((resolve) => {
          let instance: Panel | undefined;
          let ready = false;
          instance = sidepanel({
            container: document.getElementById("ask-ai-mount")!,
            ...__ASK_AI__,
            panel: { variant: "floating", side: "right" },
            onReady: () => {
              ready = true;
              if (instance) resolve(instance);
            },
          } as Parameters<typeof sidepanel>[0]) as unknown as Panel;
          if (ready || instance.isReady) resolve(instance);
        })
    ));
  // Every trigger (this button, the mobile drawer's) opens the same panel.
  document.querySelectorAll<HTMLElement>("[data-ask-ai-trigger]").forEach((t) => {
    t.addEventListener("click", () => load().then((p) => p.open()));
    t.addEventListener("mouseenter", load);
    t.addEventListener("focus", load);
  });
</script>
