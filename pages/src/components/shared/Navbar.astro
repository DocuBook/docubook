---
// Home, Features, and a Resources menu. On desktop Resources is a mega menu whose panel waits in a <template>
// (MegaMenu.astro): megaMenu.ts and megaMenu.css load on the first hover, focus or click of the trigger and stamp it then.
// In the mobile drawer it is a native <details>, so it collapses and expands with no script, and its links
// are in the page's HTML for crawlers and for the desktop menu's no-script case.
import { site } from "../../content/site";
import AskAiButton from "./AskAiButton.astro";
import Brand from "./Brand.astro";
import MegaMenu from "./MegaMenu.astro";
import Icon from "../ui/Icon.astro";
import GitHub from "../ui/icons/GitHub.astro";
import TechnicalLabel from "../ui/TechnicalLabel.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const withActive = <T extends { href: string }>(item: T) => ({ ...item, active: (item.href.replace(/\/$/, "") || "/") === path });
const items = site.nav.map(withActive);
const resources = site.resources.map(withActive);
const resourcesActive = resources.some((item) => item.active);
const reload = (item: object) => ("external" in item ? { "data-astro-reload": true } : {});
---

<nav class="relative flex h-16 items-center justify-between" aria-label="Main">
  <Brand collapsible />
  <ul class="hidden items-center gap-[34px] text-sm lg:flex">
    {items.map((item) => (
      <li>
        <a href={item.href} class:list={[item.active ? "font-semibold text-accent-ink" : "text-ink"]} aria-current={item.active ? "page" : undefined}>{item.label}</a>
      </li>
    ))}
    <li>
      <button type="button" class:list={["flex items-center gap-1", resourcesActive ? "font-semibold text-accent-ink" : "text-ink"]} aria-expanded="false" aria-haspopup="true" data-mega-trigger>
        Resources <Icon name="chevron-down" size={14} />
      </button>
    </li>
  </ul>
  <div class="hidden items-center gap-[26px] lg:flex">
    <a href={site.github} target="_blank" rel="noreferrer" class="flex items-center gap-2 text-sm text-ink"><GitHub class="size-[17px]" /> GitHub</a>
    <AskAiButton />
  </div>
  <button type="button" class="burger relative z-50 -mr-2 flex size-11 flex-col items-center justify-center gap-[5px] lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" data-nav-toggle>
    <span class="block h-0.5 w-6 bg-ink"></span>
    <span class="block h-0.5 w-6 bg-ink"></span>
    <span class="block h-0.5 w-6 bg-ink"></span>
  </button>
</nav>

<MegaMenu resources={resources} />

<div id="mobile-menu" class="drawer fixed inset-0 z-40 flex flex-col overflow-y-auto bg-paper px-5 pb-6 lg:hidden" aria-hidden="true">
  <div class="flex h-16 shrink-0 items-center"><Brand /></div>
  <ul class="flex flex-col gap-2 border-t border-rule pt-8 text-4xl font-semibold tracking-tight">
    {items.map((item) => (
      <li>
        <a href={item.href} class:list={["block py-3", item.active ? "text-accent-ink" : "text-ink"]} aria-current={item.active ? "page" : undefined}>{item.label}</a>
      </li>
    ))}
    <li>
      <details class="group" open={resourcesActive}>
        <summary class:list={["flex cursor-pointer list-none items-center justify-between py-3 [&::-webkit-details-marker]:hidden", resourcesActive ? "text-accent-ink" : "text-ink"]}>
          Resources <Icon name="chevron-down" size={28} class="transition-transform group-open:rotate-180 motion-reduce:transition-none" />
        </summary>
        <ul class="flex flex-col pb-2 text-lg font-medium tracking-normal">
          {resources.map((item) => (
            <li>
              <a href={item.href} class:list={["flex items-center gap-3 py-2", item.active ? "text-accent-ink" : "text-ink"]} aria-current={item.active ? "page" : undefined} {...reload(item)}>
                <span class="grid size-10 shrink-0 place-items-center rounded-md bg-card"><Icon name={item.icon} size={18} /></span>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </li>
  </ul>
  <div class="mt-auto flex flex-col gap-4 pt-8">
    <TechnicalLabel>Open source. MIT licensed. Yours.</TechnicalLabel>
    <div class="flex gap-3">
      <a href={site.github} target="_blank" rel="noreferrer" class="flex h-[50px] flex-1 items-center justify-center gap-2.5 rounded border border-rule bg-paper text-sm font-semibold text-ink"><GitHub class="size-[17px]" /> GitHub</a>
      <button type="button" class="flex h-[50px] flex-1 items-center justify-center gap-2.5 rounded bg-ink text-sm font-semibold text-white" data-ask-ai-trigger>
        Ask AI
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" /><path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" /></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .burger span { transition: transform 0.3s ease, opacity 0.2s ease; }
  :global([data-menu-open]) .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  :global([data-menu-open]) .burger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  :global([data-menu-open]) .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .drawer { opacity: 0; visibility: hidden; transform: translateY(-12px); transition: opacity 0.25s ease, transform 0.3s ease, visibility 0.3s; }
  :global([data-menu-open]) .drawer { opacity: 1; visibility: visible; transform: none; }
  :global([data-menu-open] body) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .burger span, .drawer { transition: none; } }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
  const menu = document.getElementById("mobile-menu")!;
  const set = (open: boolean) => {
    root.toggleAttribute("data-menu-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
  };
  toggle.addEventListener("click", () => set(!root.hasAttribute("data-menu-open")));
  menu.querySelectorAll("a, [data-ask-ai-trigger]").forEach((el) => el.addEventListener("click", () => set(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && set(false));
  matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && set(false));
</script>

<script>
  // The navbar's lazy features share this one script file: Ask AI's loader and the Resources menu's.
  import "./askAi";
  // ?url keeps the menu's styles out of the page's inlined CSS; they are attached with its script.
  import megaMenuCss from "./megaMenu.css?url";
  import { stylesheet } from "../../lib/stylesheet";

  // Resources menu: nothing of it loads until the trigger is hovered, focused or clicked. The last event before
  // it arrives decides whether it opens: a click, or a hover that is still on the trigger.
  const trigger = document.querySelector<HTMLButtonElement>("[data-mega-trigger]")!;
  const events = ["mouseenter", "focus", "click"] as const;
  let last = "";
  let loading: Promise<void> | undefined;
  const note = (e: Event) => {
    last = e.type;
    loading ??= Promise.all([import("./megaMenu"), stylesheet(megaMenuCss)]).then(
      ([menu]) => {
        events.forEach((type) => trigger.removeEventListener(type, note));
        menu.mount(trigger, last);
      },
      () => {
        // The browser remembers a module that failed to load and will not fetch it again, so there is no retry:
        // from here on a click goes to the same links in the footer.
        const toFooter = () => document.querySelector<HTMLElement>('footer [aria-label="Resources"] a')?.focus();
        events.forEach((type) => trigger.removeEventListener(type, note));
        trigger.addEventListener("click", toFooter);
        if (last === "click") toFooter();
      }
    );
  };
  events.forEach((type) => trigger.addEventListener(type, note));
</script>
