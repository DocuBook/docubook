---
// Pen "Publishing pipeline": four workflow steps, one highlighted in dark.
import type { Step } from "../../content/home";
import Icon from "../ui/Icon.astro";
import TechnicalLabel from "../ui/TechnicalLabel.astro";
interface Props { steps: Step[] }
const { steps } = Astro.props;
---

<ol class="grid gap-[30px] sm:grid-cols-2 lg:grid-cols-4 lg:gap-5 xl:gap-[30px]">
  {steps.map((step, i) => (
    <li class="flex flex-col gap-6">
      <div class="flex items-center justify-between">
        <TechnicalLabel tone={step.highlight ? "accent" : "muted"}>{String(i + 1).padStart(2, "0")} / {step.label}</TechnicalLabel>
        <Icon name="arrow-right" size={18} class="text-muted" />
      </div>
      <div class:list={["flex h-[84px] items-center gap-[13px] rounded border px-[23px] lg:px-4 xl:px-[23px]", step.highlight ? "border-dark bg-dark text-dark-code" : "border-rule bg-card text-ink"]}>
        <Icon name={step.icon} size={25} />
        <span class="font-mono text-[17px] lg:text-[15px] xl:text-[17px]">{step.artifact}</span>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="text-[20px] font-semibold leading-tight text-ink">{step.title}</h3>
        <p class="text-[15px] leading-relaxed text-muted">{step.description}</p>
      </div>
    </li>
  ))}
</ol>
