---
// The DocuBook panda as inline SVG (same drawing as public/images/docubook-icon.svg) so its pupils can move.
// Radial gradients give it volume; `hands` adds two paws pressed against the footer edge for the peeking pose.
// `id` namespaces the defs: the header and the footer each render one.
interface Props { id: string; class?: string; hands?: boolean }
const { id, class: className = "", hands = false } = Astro.props;
---

<svg viewBox="0 0 1024 1024" class={className} data-mascot aria-hidden="true">
  <defs>
    <path id={`${id}-head`} d="M512 176 C716 176 860 296 864 476 L894 540 L858 562 L886 610 L836 626
      C784 744 664 800 512 800 C360 800 240 744 188 626 L138 610 L166 562 L130 540 L160 476
      C164 296 308 176 512 176 Z"/>
    <path id={`${id}-chest`} d="M336 1010 C336 840 420 770 512 770 C604 770 688 840 688 1010 Z"/>
    <path id={`${id}-patchL`} d="M268 430 C276 370 352 352 446 404 C494 436 500 520 456 572 C408 626 316 624 280 568 C256 530 262 470 268 430 Z"/>
    <path id={`${id}-patchR`} d="M756 430 C748 370 672 352 578 404 C530 436 524 520 568 572 C616 626 708 624 744 568 C768 530 762 470 756 430 Z"/>
    <path id={`${id}-nose`} d="M454 612 C454 584 570 584 570 612 C570 646 534 670 512 676 C490 670 454 646 454 612 Z"/>
    <radialGradient id={`${id}-blue`} cx="38%" cy="30%" r="80%"><stop offset="0" stop-color="#5aa4ec"/><stop offset="0.55" stop-color="#2483e2"/><stop offset="1" stop-color="#1a63b8"/></radialGradient>
    <radialGradient id={`${id}-fur`} cx="42%" cy="35%" r="75%"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dbe8f7"/></radialGradient>
    <radialGradient id={`${id}-patch`} cx="40%" cy="35%" r="80%"><stop offset="0" stop-color="#3b92e8"/><stop offset="1" stop-color="#1a63b8"/></radialGradient>
    <clipPath id={`${id}-badgeClip`}><circle cx="512" cy="548" r="452"/></clipPath>
        <mask id={`${id}-shadeMask`}>
      <use href={`#${id}-head`} fill="#fff"/><use href={`#${id}-head`} fill="#000" transform="translate(40 -34)"/>
    </mask>
  </defs>
  <g stroke="#0d2b52" stroke-linejoin="round" stroke-linecap="round">
    <circle cx="512" cy="548" r="452" fill={`url(#${id}-blue)`} stroke-width="16"/>
    <g clip-path={`url(#${id}-badgeClip)`}>
      <use href={`#${id}-chest`} fill="#fff" stroke-width="14"/>
    </g>
    <circle cx="292" cy="228" r="104" fill={`url(#${id}-blue)`} stroke-width="16"/>
    <circle cx="732" cy="228" r="104" fill={`url(#${id}-blue)`} stroke-width="16"/>
    <circle cx="300" cy="238" r="50" fill="#5aa4ec" stroke="none"/>
    <circle cx="724" cy="238" r="50" fill="#5aa4ec" stroke="none"/>
    <use href={`#${id}-head`} fill={`url(#${id}-fur)`} stroke="none"/>
    <rect width="1024" height="1024" fill="#cfe0f4" mask={`url(#${id}-shadeMask)`} stroke="none" opacity="0.8"/>
    <use href={`#${id}-head`} fill="none" stroke-width="16"/>
    <use href={`#${id}-patchL`} fill={`url(#${id}-patch)`} stroke="none"/>
    <use href={`#${id}-patchR`} fill={`url(#${id}-patch)`} stroke="none"/>
    <circle cx="378" cy="476" r="74" fill="#fff" stroke-width="13"/>
    <circle cx="646" cy="476" r="74" fill="#fff" stroke-width="13"/>
    <g data-pupils>
    <circle cx="396" cy="488" r="30" fill="#0d2b52" stroke="none"/>
      <circle cx="628" cy="488" r="30" fill="#0d2b52" stroke="none"/>
      <circle cx="406" cy="476" r="10" fill="#fff" stroke="none"/>
      <circle cx="638" cy="476" r="10" fill="#fff" stroke="none"/>
    </g>
    <path d="M286 382 L462 424 M738 382 L562 424" fill="none" stroke-width="34"/>
    <ellipse cx="512" cy="648" rx="128" ry="92" fill="#fff" stroke-width="12"/>
    <use href={`#${id}-nose`} fill="#0d2b52" stroke="none"/>
    <path d="M512 672 L512 698 M446 704 C476 724 500 718 512 698 C524 718 548 724 578 704"
      fill="none" stroke-width="14"/>
    {hands && (
      <g data-hands>
        <g transform="translate(300 838)">
          <circle cx="-52" cy="-56" r="30" fill={`url(#${id}-blue)`} stroke-width="14"/><circle cx="0" cy="-70" r="32" fill={`url(#${id}-blue)`} stroke-width="14"/><circle cx="54" cy="-54" r="30" fill={`url(#${id}-blue)`} stroke-width="14"/>
          <ellipse cx="0" cy="0" rx="86" ry="66" fill={`url(#${id}-blue)`} stroke-width="14"/>
          <ellipse cx="0" cy="6" rx="46" ry="32" fill="#5aa4ec" stroke="none" opacity="0.9"/>
          <ellipse cx="-20" cy="-18" rx="26" ry="12" fill="#fff" stroke="none" opacity="0.45"/>
        </g>
        <g transform="translate(724 838) scale(-1 1)">
          <circle cx="-52" cy="-56" r="30" fill={`url(#${id}-blue)`} stroke-width="14"/><circle cx="0" cy="-70" r="32" fill={`url(#${id}-blue)`} stroke-width="14"/><circle cx="54" cy="-54" r="30" fill={`url(#${id}-blue)`} stroke-width="14"/>
          <ellipse cx="0" cy="0" rx="86" ry="66" fill={`url(#${id}-blue)`} stroke-width="14"/>
          <ellipse cx="0" cy="6" rx="46" ry="32" fill="#5aa4ec" stroke="none" opacity="0.9"/>
          <ellipse cx="-20" cy="-18" rx="26" ry="12" fill="#fff" stroke="none" opacity="0.45"/>
        </g>
      </g>
    )}
  </g>
</svg>
