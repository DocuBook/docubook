---
// Copy on the left, a terminal on the right: one tab per runtime, one command per step. Home's quickstart and
// the deploy page's build steps both use it. A page holds one at most: the script below queries the document.
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import TechnicalLabel from "../ui/TechnicalLabel.astro";
interface Props { label: string; heading: string; description: string; link: { href: string; label: string }; comments: string[]; runtimes: { name: string; commands: string[] }[]; footnote: string; class?: string }
const { label, heading, description, link, comments, runtimes, footnote, class: className = "py-24" } = Astro.props;
---

<Container as="section" class:list={["flex flex-col gap-12 lg:flex-row lg:items-center xl:gap-[90px]", className]}>
  <div class="flex max-w-[500px] shrink-0 flex-col gap-[23px] lg:max-w-[360px] xl:max-w-[500px]">
    <TechnicalLabel tone="accent">{label}</TechnicalLabel>
    <h2 class="text-3xl font-semibold leading-[1.05] tracking-tight whitespace-pre-line sm:text-5xl lg:text-[40px] xl:text-[58px]">{heading}</h2>
    <p class="text-[17px] leading-relaxed text-muted">{description}</p>
    <a href={link.href} class="flex items-center gap-2.5 text-sm font-semibold" {...(link.href.startsWith("/docs") ? { "data-astro-reload": true } : {})}>{link.label} <Icon name="arrow-up-right" size={17} /></a>
  </div>
  <div class="flex w-full flex-col gap-[17px] lg:max-w-[720px]">
    <div class="overflow-hidden rounded-lg bg-dark font-mono">
      {/* The tablist holds only the tabs; the copy button sits beside it so the list has no foreign children. */}
      <div class="flex h-[58px] items-center border-b border-dark-rule px-6 text-[13px]">
        <div class="flex h-full items-center gap-7" role="tablist" aria-label="Runtime">
          {runtimes.map((r, i) => <button type="button" role="tab" id={`runtime-tab-${i}`} aria-controls={`runtime-panel-${i}`} data-tab={i} aria-selected={i === 0} class="flex h-full items-center border-b border-transparent px-[5px] text-dark-muted aria-selected:border-accent aria-selected:text-dark-ink">{r.name}</button>)}
        </div>
        <button type="button" data-copy class="ml-auto text-dark-muted hover:text-dark-ink" aria-label="Copy commands"><Icon name="copy" size={16} class="[[data-copied]_&]:hidden" /><Icon name="check" size={16} class="hidden text-ok [[data-copied]_&]:block" /></button>
      </div>
      {runtimes.map((r, i) => (
        <div role="tabpanel" id={`runtime-panel-${i}`} aria-labelledby={`runtime-tab-${i}`} data-panel={i} data-commands={r.commands.join("\n")} class:list={[i !== 0 && "hidden"]}>
          <ol class="flex flex-col gap-[26px] p-[30px]">
            {r.commands.map((cmd, j) => <li class="flex flex-col gap-[9px]"><span class="text-[11px] text-dark-muted">{comments[j]}</span><code class="text-[15px] text-dark-code xl:text-[17px]">$ {cmd}</code></li>)}
          </ol>
        </div>
      ))}
    </div>
    <TechnicalLabel>{footnote}</TechnicalLabel>
  </div>
</Container>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
      panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== tab.dataset.tab));
    })
  );
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  copy.addEventListener("click", async () => {
    const active = document.querySelector<HTMLElement>("[data-panel]:not(.hidden)")!;
    await navigator.clipboard.writeText(active.dataset.commands!);
    copy.toggleAttribute("data-copied", true);
    setTimeout(() => copy.removeAttribute("data-copied"), 1500);
  });
</script>
