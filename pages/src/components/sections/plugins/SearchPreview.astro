---
// Left: the DocSearch dialog with full-text hits. Right: the Ask AI side panel.
import { searchResults } from "../../../content/plugins";
import Icon from "../../ui/Icon.astro";
---

<div class="sq grid gap-3.5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" data-animate aria-label="Search for nginx: three full-text hits in 12 ms. Ask AI answers how to serve the docs under /docs with nginx.">
  <div class="overflow-hidden rounded border border-dark-rule bg-dark">
    <div class="flex items-center justify-between px-3.5 py-3">
      <span class="flex items-center gap-2.5 font-mono text-[13px] text-dark-code"><Icon name="search" size={15} class="text-accent" /><span class="sq-type">nginx</span><span class="sq-caret text-accent" aria-hidden="true">▍</span></span>
      <span class="rounded-[3px] border border-dark-rule px-1.5 py-0.5 font-mono text-[9px] text-dark-muted">ESC</span>
    </div>
    <hr class="h-px border-0 bg-dark-rule" />
    <div class="sq-hits flex items-center justify-between px-3.5 py-2 font-mono text-[9px]"><span class="text-dark-muted">FULL-TEXT · 3 HITS</span><span class="text-ok">12 MS</span></div>
    {searchResults.map((r, i) => (
      <div class:list={["sq-hits flex items-center gap-2.5 px-3.5 py-[9px]", `sq-hit-${i + 1}`, r.active && "bg-[#353b2f]"]}>
        <Icon name="file-text" size={14} class="text-dark-muted" />
        <div class="flex flex-1 flex-col gap-[3px]">
          <span class="text-xs text-dark-code">{r.before}<mark class="bg-transparent font-semibold text-accent underline">{r.match}</mark>{r.after}</span>
          <span class="font-mono text-[9px] uppercase text-dark-muted">{r.crumb}</span>
        </div>
        {r.active && <Icon name="corner-down-left" size={12} class="text-dark-muted" />}
      </div>
    ))}
  </div>
  <div class="flex flex-col gap-2.5 rounded border border-dark-rule bg-dark p-3.5">
    <div class="flex items-center justify-between font-mono">
      <span class="flex items-center gap-[7px] text-[11px] font-medium text-accent"><Icon name="sparkles" size={14} />ASK AI</span>
      <span class="text-[9px] text-dark-muted">⌘ I</span>
    </div>
    <hr class="h-px border-0 bg-dark-rule" />
    <p class="sq-q text-xs leading-snug text-dark-ink">How do I serve the docs under /docs with nginx?</p>
    <p class="sq-a text-[11px] leading-relaxed text-dark-muted">Set basePath in docu.json and run flame build. Flame writes nginx rules that follow the prefix, so links, canonical URLs and search records stay in sync. ▍</p>
    <span class="sq-src font-mono text-[9px] text-ok">SOURCES · deployment.mdx · base-path.mdx</span>
  </div>
</div>

<style>
  /* Search demo, one 9s cycle: type the query, hits land, the highlight steps down and back, Ask AI streams its answer, fade out, repeat.
     The markup is the finished frame; the loop runs only while [data-playing] (near the viewport). */
  .sq-type { overflow: hidden; white-space: nowrap; }
  .sq[data-playing] :is(.sq-type, .sq-hits, .sq-q, .sq-a, .sq-src) { animation-duration: 9s; animation-timing-function: ease; animation-iteration-count: infinite; }
  .sq[data-playing] .sq-type { animation-name: sq-type; animation-timing-function: steps(5, end); } /* 5 = chars in "nginx" */
  .sq[data-playing] .sq-caret { animation: sq-caret 1s steps(1) infinite; }
  .sq[data-playing] .sq-hits { animation-name: sq-in-a; }
  .sq[data-playing] .sq-hit-1 { animation-name: sq-in-a, sq-pick-1; }
  .sq[data-playing] .sq-hit-2 { animation-name: sq-in-a, sq-pick-2; }
  .sq[data-playing] .sq-hit-3 { animation-name: sq-in-a, sq-pick-3; }
  .sq[data-playing] .sq-q { animation-name: sq-in-b; }
  .sq[data-playing] .sq-a { animation-name: sq-stream; }
  .sq[data-playing] .sq-src { animation-name: sq-in-c; }
  @keyframes sq-type { 0%, 4% { width: 0; } 16%, 100% { width: 5ch; } }
  @keyframes sq-caret { 50% { opacity: 0; } }
  @keyframes sq-in-a { 0%, 18% { opacity: 0; translate: 0 4px; } 22%, 90% { opacity: 1; translate: none; } 97%, 100% { opacity: 0; translate: none; } }
  @keyframes sq-in-b { 0%, 24% { opacity: 0; translate: 0 4px; } 28%, 90% { opacity: 1; translate: none; } 97%, 100% { opacity: 0; translate: none; } }
  @keyframes sq-in-c { 0%, 56% { opacity: 0; translate: 0 4px; } 60%, 90% { opacity: 1; translate: none; } 97%, 100% { opacity: 0; translate: none; } }
  @keyframes sq-stream { 0%, 31% { clip-path: inset(0 0 100% 0); opacity: 1; } 53%, 90% { clip-path: inset(0); opacity: 1; } 97%, 100% { clip-path: inset(0); opacity: 0; } }
  @keyframes sq-pick-1 { 0%, 32% { background-color: #353b2f; } 33%, 55% { background-color: transparent; } 56%, 100% { background-color: #353b2f; } }
  @keyframes sq-pick-2 { 0%, 32% { background-color: transparent; } 33%, 43% { background-color: #353b2f; } 44%, 100% { background-color: transparent; } }
  @keyframes sq-pick-3 { 0%, 43% { background-color: transparent; } 44%, 55% { background-color: #353b2f; } 56%, 100% { background-color: transparent; } }
  @media (prefers-reduced-motion: reduce) { .sq * { animation: none !important; } }
</style>
