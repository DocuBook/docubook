---
import { site } from "../../../content/site";
import Container from "../../ui/Container.astro";
import Icon from "../../ui/Icon.astro";
import GitHub from "../../ui/icons/GitHub.astro";
import TechnicalLabel from "../../ui/TechnicalLabel.astro";
const repo = new URL(site.github).pathname.slice(1);
// Build-time stats and description so the first paint already shows the real repo; the browser refreshes them later.
// Offline or rate-limited builds keep the placeholders.
const compact = new Intl.NumberFormat("en", { notation: "compact" });
const built = await fetch(`https://api.github.com/repos/${repo}`, {
  headers: { Accept: "application/vnd.github+json", ...(process.env.GITHUB_TOKEN ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {}) },
  signal: AbortSignal.timeout(5000),
})
  .then((res) => (res.ok ? res.json() : null))
  .catch(() => null);
// When the numbers above were fetched; 0 when the build kept the placeholders.
const builtAt = built ? Date.now() : 0;
const initial = {
  stars: built ? compact.format(built.stargazers_count) : "–",
  forks: built ? compact.format(built.forks_count) : "–",
  license: built?.license?.spdx_id ?? "MIT",
  description: built?.description || "A markdown-first documentation framework. Human-readable source. Flat static output.",
};
---

<section class="border-y border-rule bg-[#fffefa]">
  <Container class="flex flex-col gap-12 py-[82px] lg:flex-row lg:items-center xl:gap-[110px]">
    <div class="flex max-w-[620px] flex-col gap-[21px] lg:max-w-[440px] xl:max-w-[620px]">
      <TechnicalLabel tone="accent">08 / Open by default</TechnicalLabel>
      <h2 class="text-3xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-[40px] xl:text-[58px]">Open source.<br />Not a walled garden.</h2>
      <p class="text-[17px] leading-relaxed text-muted">An open-source alternative to Mintlify or GitBook. Read the code, open an issue, or help shape what comes next. DocuBook is MIT licensed — and built in the open.</p>
    </div>
    <a href={site.github} target="_blank" rel="noreferrer" class="flex w-full flex-col gap-[23px] rounded border border-rule p-[29px] lg:max-w-[550px]">
      <div class="flex items-center gap-3">
        <span class="gh-mark relative size-[26px]" aria-hidden="true" data-animate>
          <GitHub class="gh-logo absolute inset-0 size-[26px]" />
          <Icon name="star" size={26} class="gh-star absolute inset-0 text-accent fill-current" />
          <i class="gh-ring absolute inset-0 rounded-full border-2 border-accent"></i>
          <i class="gh-ring gh-ring-2 absolute inset-0 rounded-full border border-accent"></i>
        </span>
        <span class="whitespace-nowrap text-lg font-semibold xl:text-xl">{repo.replace("/", " / ")}</span>
      </div>
      <div class="flex flex-col gap-[23px]" data-repo={repo} data-built-at={builtAt}>
        <p class="text-[15px] leading-relaxed text-muted" data-stat="description">{initial.description}</p>
        <div class="flex flex-wrap items-center gap-5 font-mono text-[11px] text-muted">
          <span class="flex items-center gap-[7px]"><Icon name="star" size={15} /><span data-stat="stars">{initial.stars}</span> stars</span>
          <span class="flex items-center gap-[7px]"><Icon name="git-fork" size={15} /><span data-stat="forks">{initial.forks}</span> forks</span>
          <span class="flex items-center gap-[7px]"><Icon name="scale" size={15} /><span data-stat="license">{initial.license}</span> license</span>
        </div>
      </div>
      <hr class="h-px border-0 bg-rule" />
      <div class="flex items-center justify-between font-mono text-[11px] text-muted">github.com/{repo} <Icon name="arrow-up-right" size={21} /></div>
    </a>
  </Container>
</section>

<style>
  /* GitHub mark flips to a star with a splash every 6s, and stays a star while the card is hovered: a nudge to go star the repo. */
  /* Loops only while [data-playing] (near the viewport); otherwise it rests on the GitHub mark. */
  .gh-mark :global(.gh-star), .gh-mark :global(.gh-ring) { opacity: 0; }
  .gh-mark[data-playing] :global(.gh-logo), .gh-mark[data-playing] :global(.gh-star), .gh-mark[data-playing] :global(.gh-ring) { animation-duration: 6s; animation-timing-function: ease; animation-iteration-count: infinite; }
  .gh-mark[data-playing] :global(.gh-logo) { animation-name: gh-logo; }
  .gh-mark[data-playing] :global(.gh-star) { animation-name: gh-star; }
  .gh-mark[data-playing] :global(.gh-ring) { animation-name: gh-ring; }
  .gh-mark[data-playing] :global(.gh-ring-2) { animation-delay: 0.15s; }
  a:hover .gh-mark[data-playing] :global(*) { animation: none; }
  a:hover .gh-mark :global(.gh-logo) { opacity: 0; }
  a:hover .gh-mark :global(.gh-star) { opacity: 1; }
  @keyframes gh-logo { 0%, 55% { opacity: 1; scale: 1; } 61%, 88% { opacity: 0; scale: 0.5; } 95%, 100% { opacity: 1; scale: 1; } }
  @keyframes gh-star { 0%, 56% { opacity: 0; scale: 0.3; rotate: -40deg; } 63% { opacity: 1; scale: 1.2; rotate: 8deg; } 67%, 88% { opacity: 1; scale: 1; rotate: 0deg; } 95%, 100% { opacity: 0; scale: 0.3; rotate: 0deg; } }
  @keyframes gh-ring { 0%, 56% { opacity: 0; scale: 0.6; } 59% { opacity: 0.9; scale: 0.8; } 75%, 100% { opacity: 0; scale: 2.1; } }
  @media (prefers-reduced-motion: reduce) { .gh-mark :global(*) { animation: none !important; } }
</style>

<script>
  // Repo stats and description from the GitHub API, cached in localStorage for 7 days. On any failure the static text stays.
  // The page already carries the stats fetched at build time: a cache entry older than the build never
  // replaces them, and while they are younger than the TTL the browser does not refetch at all.
  const root = document.querySelector<HTMLElement>("[data-repo]")!;
  const builtAt = Number(root.dataset.builtAt) || 0;
  const key = `gh:${root.dataset.repo}`;
  const ttl = 7 * 24 * 60 * 60 * 1000;
  const compact = new Intl.NumberFormat("en", { notation: "compact" });
  type Stats = { stars: number; forks: number; license: string | null; description?: string | null };
  async function stats(): Promise<Stats | null> {
    const cached = JSON.parse(localStorage.getItem(key) ?? "null") as { at: number; data: Stats } | null;
    if (cached && cached.at > builtAt && Date.now() - cached.at < ttl) return cached.data;
    if (Date.now() - builtAt < ttl) return null;
    const res = await fetch(`https://api.github.com/repos/${root.dataset.repo}`, { headers: { Accept: "application/vnd.github+json" } });
    if (!res.ok) throw new Error(res.statusText);
    const j = await res.json();
    const data: Stats = { stars: j.stargazers_count, forks: j.forks_count, license: j.license?.spdx_id ?? null, description: j.description ?? null };
    localStorage.setItem(key, JSON.stringify({ at: Date.now(), data }));
    return data;
  }
  // Fetched once the card is near the viewport, so the API call stays off the page load.
  const io = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    stats()
      .then((data) => {
        if (!data) return;
        const { stars, forks, license, description } = data;
        root.querySelector("[data-stat=stars]")!.textContent = compact.format(stars);
        root.querySelector("[data-stat=forks]")!.textContent = compact.format(forks);
        if (license) root.querySelector("[data-stat=license]")!.textContent = license;
        // Cache entries written before the description was stored have none: the build-time text stays.
        if (description) root.querySelector("[data-stat=description]")!.textContent = description;
      })
      .catch(() => {});
  }, { rootMargin: "400px 0px" });
  io.observe(root);
</script>
