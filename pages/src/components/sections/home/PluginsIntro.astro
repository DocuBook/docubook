---
import { pluginSteps } from "../../../content/home";
import SectionIntro from "../../shared/SectionIntro.astro";
import Steps from "../../shared/Steps.astro";
import Container from "../../ui/Container.astro";
---

<Container as="section" class="flex flex-col gap-12 py-24">
