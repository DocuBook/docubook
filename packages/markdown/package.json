{
  "name": "@docubook/markdown",
  "version": "2.2.1",
  "description": "Portable MDX components and framework adapters for DocuBook",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && vite build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "docubook",
    "mdx",
    "react",
    "components",
    "mdx-components"
  ],
  "homepage": "https://docubook.pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocuBook/docubook"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "wildan.nrs",
  "author-url": "https://wildan.dev",
  "license": "MIT",
  "dependencies": {
    "mermaid": "^11.17.2"
  },
  "peerDependencies": {
    "@docubook/core": "workspace:^",
    "lucide-react": "^1.7.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
