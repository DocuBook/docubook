{
  "$schema": "https://cdn.jsdelivr.net/npm/@docubook/flame/docu.schema.json",
  "meta": {
    "title": "DocuBook Flame",
    "description": "A markdown-first documentation framework. Write with directives, compile to flat static HTML — no runtime, no server, no lock-in. Runs on Bun, Node.js, or Deno.",
    "baseURL": "https://docubook.pro/",
    "favicon": "/docs/assets/images/favicon.ico",
    "verification": {
      "algolia-site-verification": "3977D491A9531EBA"
    },
    "basePath": "/docs"
  },
  "experimental": {
    "pages": true
  },
  "sidebar": {
    "context": "separator"
  },
  "themes": {
    "colors": "default"
  },
  "navbar": {
    "logo": {
      "src": "/docs/assets/images/icon.svg",
      "alt": "DocuBook"
    },
    "logoText": "DocuBook",
    "menu": [
      {
        "title": "Home",
        "href": "/"
      },
      {
        "title": "Docs",
        "href": "/docs"
      }
    ]
  },
  "footer": {
    "social": [
      {
        "name": "facebook",
        "url": "https://www.facebook.com/wildan.nrsh"
      },
      {
        "name": "instagram",
        "url": "https://www.instagram.com/wildan.nrs/"
      },
      {
        "name": "npm",
        "url": "https://www.npmjs.com/~wildan.nrs"
      },
      {
        "name": "youtube",
        "url": "https://youtube.com/@wildandotdev"
      },
      {
        "name": "x",
        "url": "https://x.com/wildan_nrss"
      },
      {
        "name": "threads",
        "url": "https://www.threads.com/@wildan.nrs"
      }
    ]
  },
  "repo": {
    "url": "https://github.com/DocuBook/docubook",
    "path": "blob/main/packages/flame/{filePath}",
    "edit": true
  },
  "plugins": [
    [
      "@docubook/plugin-search-algolia",
      {
        "appId": "5CCYZZZ96E",
        "apiKey": "96e2ea3739eeed056a314c85925e8079",
        "indexName": "docsearch_docubook",
        "askAi": "cdd1d1a2-5e49-400e-a093-3cdcc838731c"
      }
    ],
    "@docubook/plugin-og-image"
  ],
  "routes": [
    {
      "title": "Getting Started",
      "href": "/getting-started",
      "noLink": true,
      "context": {
        "icon": "BookOpen",
        "description": "Set up your Documentation",
        "title": "Guides"
      },
      "items": [
        {
          "title": "Introduction",
          "href": "/introduction"
        },
        {
          "title": "Installation",
          "href": "/installation"
        },
        {
