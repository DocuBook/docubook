{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 4am on monday"],
  "timezone": "UTC",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "description": "Ignore internal monorepo workspace packages",
      "matchPackagePatterns": ["^@docubook/"],
      "enabled": false
    },
    {
      "description": "Group minor and patch dependencies in packages/",
      "matchFileNames": ["packages/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages minor and patch dependencies"
    },
    {
      "description": "Separate major updates in packages/",
      "matchFileNames": ["packages/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "packages major dependencies"
    },
    {
      "description": "Group root devDependencies",
      "matchFileNames": ["package.json"],
      "groupName": "root devDependencies"
    }
  ]
}
